# Copy to secrets.toml locally, or paste into Community Cloud Advanced settings.
# Upload the four inference files at the root of a private HF model repository.
RESUME_MATCHER_HF_REPO = "YOUR_USERNAME/resume-job-matcher-weighted"
RESUME_MATCHER_HF_REVISION = "REPLACE_WITH_FULL_40_CHARACTER_COMMIT_SHA"
HF_TOKEN = "REPLACE_WITH_READ_ONLY_TOKEN"

# Optional: enable the protected /?performance=1 view during verification.
# Remove this setting afterwards.
PERFORMANCE_TOKEN = "REPLACE_WITH_LONG_RANDOM_MAINTAINER_PASSWORD"
